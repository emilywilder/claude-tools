import '../../just/install.just'

src := source_directory() / "annotree.py"
dest := bindir / "annotree"

# Install annotree into bindir
[unix]
install:
    @mkdir -p {{quote(bindir)}}
    @rm -f {{quote(dest)}}
    @if [ {{quote(mode)}} = link ]; then \
        ln -s {{quote(src)}} {{quote(dest)}}; \
    else \
        cp {{quote(src)}} {{quote(dest)}} && chmod 755 {{quote(dest)}}; \
    fi
    @echo "    {{dest}}"

# Install annotree into bindir, with a .cmd launcher
[windows]
[script("pwsh", "-NoLogo", "-NoProfile", "-File")]
[extension(".ps1")]
install:
    $ErrorActionPreference = 'Stop'
    New-Item -ItemType Directory -Force -Path '{{bindir}}' | Out-Null
    if ('{{mode}}' -eq 'link') {
        $target = '{{src}}'
    } else {
        Copy-Item -Force '{{src}}' '{{dest}}'
        $target = '%~dp0annotree'
    }
    Set-Content -Encoding ascii -Path '{{dest}}.cmd' -Value "@python `"$target`" %*"
    Write-Output "    {{dest}}.cmd"
